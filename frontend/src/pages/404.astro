---
import Base from "../layouts/Base.astro";
---
<Base title="Page not found" description="This page does not exist." noindex>
  <section class="section not-found">
    <div class="container">
      <h1>Page not found</h1>
      <p class="lead">The page you are looking for has moved or never existed.</p>
      <div class="actions">
        <a class="btn btn-primary" href="/">Back to home</a>
        <a class="btn btn-secondary" href="/docs">Read the docs</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .not-found {
    min-height: calc(100vh - var(--header-h));
    display: grid;
    place-items: center;
    text-align: center;
  }
  .not-found .container { display: flex; flex-direction: column; align-items: center; }
  .not-found .lead { margin-inline: auto; }
  .actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: 8px; }
</style>
