---
import Base from "../../layouts/Base.astro";
import { groupedDocs } from "../../components/docs/docs";
const groups = await groupedDocs();
---
<Base title="Documentation" description="Guides for installing Imagory, adding photo folders and Google Takeout exports, and fixing common problems.">
  <div class="container wrap">
    <h1>Documentation</h1>
    <p class="lead">Short guides for using Imagory. Everything here works offline, on your own computer.</p>
    {groups.map((g) => (
      <section>
        <h2>{g.name}</h2>
        <ul class="cards">
          {g.items.map((d) => (
            <li><a class="card" href={`/docs/${d.id}`}><strong>{d.data.title}</strong><span>{d.data.description}</span></a></li>
          ))}
          {g.name === "Help" && (
            <li><a class="card" href="/privacy"><strong>Privacy</strong><span>What the app does, and what this website measures.</span></a></li>
          )}
        </ul>
      </section>
    ))}
  </div>
</Base>
<style>
  .wrap { padding-block: 48px 96px; }
  h1 { font-size: clamp(2.2rem, 5vw, 3.25rem); margin-bottom: 12px; }
  section { margin-top: 40px; }
  h2 { font-size: 1.3rem; margin-bottom: 16px; }
  .cards { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); }
  .card { display: flex; flex-direction: column; gap: 6px; height: 100%; text-decoration: none; color: var(--text); }
  .card:hover { border-color: var(--selection); }
  .card span { color: var(--muted); font-size: .95rem; }
</style>
