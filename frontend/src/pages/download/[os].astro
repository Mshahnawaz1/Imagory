---
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import { downloads, release, latestRelease, links, downloadPage, type Os } from "../../site";

export function getStaticPaths() {
  return (["windows", "linux"] as Os[]).map((os) => ({ params: { os } }));
}
const os = Astro.params.os as Os;
const d = downloads[os];
const url = latestRelease;
const other: Os = os === "windows" ? "linux" : "windows";
---
<Base title="Thanks for downloading" description={`Download Imagory for ${d.label}.`} noindex>
  <noscript slot="head"><meta http-equiv="refresh" content={`1;url=${url}`} /></noscript>
  <section class="section container">
    <div class="prose">
      <p class="eyebrow">Imagory for {d.label}</p>
      <h1>Thanks for downloading Imagory</h1>
      <p class="lead">Taking you to the latest release on GitHub. Under <strong>Assets</strong>, download the file below.</p>

      <div class="card file">
        <div class="icon-box"><Icon name={os} /></div>
        <div>
          <strong class="fname">{d.file}</strong>
          <div class="muted">Version {release.version} · {d.size}</div>
        </div>
      </div>

      <p><a class="btn btn-primary btn-lg" href={url}><Icon name="download" />Not redirected? Open the latest release</a></p>
      <p><a href={links.releases}>All releases</a></p>

      <h2>Next steps</h2>
      {os === "windows" ? (
        <ol>
          <li>Download <code>Imagory.exe</code> from the release, then double-click it. There is no installer.</li>
          <li>If Windows SmartScreen warns you, choose <strong>More info</strong>, then <strong>Run anyway</strong>. <a href="/docs/windows-warnings">Why this happens</a>.</li>
          <li>Add a photo folder and let Imagory scan it.</li>
        </ol>
      ) : (
        <>
          <ol>
            <li>Download the <code>.tar.gz</code> from the release and unpack it.</li>
            <li>Run the app.</li>
            <li>If it does not start, install the Qt library <code>libxcb-cursor0</code>.</li>
          </ol>
          <pre><code>tar -xzf {d.file}
./Imagory</code></pre>
          <pre><code>sudo apt install libxcb-cursor0</code></pre>
        </>
      )}
      <p><a href="/docs/getting-started">Read the getting started guide</a> · <a href={downloadPage(other)}>Get Imagory for {downloads[other].label} instead</a></p>
    </div>
  </section>
  <script is:inline define:vars={{ url }}>
    setTimeout(function () { location.href = url; }, 1000);
  </script>
</Base>
<style>
  .file { display: flex; align-items: center; gap: 16px; margin: 24px 0; }
  .fname { font-family: var(--font-mono); font-size: 0.95rem; overflow-wrap: anywhere; }
  .btn-lg { max-width: 100%; }
  @media (max-width: 480px) { .btn-lg { padding: 16px 20px; font-size: 1rem; } }
</style>
