  description="Browse your local photo folders and Google Takeout exports, fast and fully offline. Free and open source for Windows and Linux."
>
  <AnnouncementBar slot="top" />
  <Hero />
  <FeatureStrip />
  <Showcase />
  <Fast />
  <Cleanup />
  <FeatureGrid />
  <DownloadBand />
  <Faq />
</Base>
