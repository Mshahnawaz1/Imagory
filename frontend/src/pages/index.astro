---
import Base from "../layouts/Base.astro";
import AnnouncementBar from "../components/home/AnnouncementBar.astro";
import Hero from "../components/home/Hero.astro";
import FeatureStrip from "../components/home/FeatureStrip.astro";
import Showcase from "../components/home/Showcase.astro";
import Fast from "../components/home/Fast.astro";
import Cleanup from "../components/home/Cleanup.astro";
import FeatureGrid from "../components/home/FeatureGrid.astro";
import DownloadBand from "../components/home/DownloadBand.astro";
import Faq from "../components/home/Faq.astro";
---
<Base
