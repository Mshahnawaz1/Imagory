---
import { groupedDocs } from "./docs";
interface Props { current?: string }
const { current } = Astro.props;
const groups = await groupedDocs();
---
<nav class="docs-nav" aria-label="Documentation">
  {groups.map((g) => (
    <div class="group">
      <p class="group-title">{g.name}</p>
      <ul>
        {g.items.map((d) => (
          <li><a href={`/docs/${d.id}`} aria-current={d.id === current ? "page" : undefined}>{d.data.title}</a></li>
        ))}
        {g.name === "Help" && <li><a href="/privacy">Privacy</a></li>}
      </ul>
    </div>
  ))}
</nav>
<style>
  .group + .group { margin-top: 24px; }
  .group-title { font-size: .8125rem; font-weight: 600; color: var(--text); margin: 0 0 8px; }
  ul { list-style: none; margin: 0; padding: 0; }
  a { display: block; padding: 6px 12px; color: var(--text); text-decoration: none; border-left: 2px solid var(--line); font-size: .9rem; }
  a:hover { background: var(--surface-alt); }
  a[aria-current="page"] { border-left-color: var(--selection); background: var(--surface-alt); font-weight: 600; color: var(--selection); }
</style>
