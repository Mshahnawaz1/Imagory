---
// Extra stroke icons for the home page (24x24 grid, same style as Icon.astro).
export type HomeIconName =
  | "offline" | "shield" | "bolt" | "takeout" | "duplicates" | "calendar" | "search"
  | "album" | "people" | "zoom" | "check" | "folder" | "file" | "plus" | "megaphone";
interface Props { name: HomeIconName; class?: string }
const { name, class: cls } = Astro.props;
---
<svg class={cls} viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor"
  stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === "offline" && (<><path d="M2 8.5a15 15 0 0 1 4.2-2.6M9.8 5.1A15 15 0 0 1 22 8.5M5 12a10 10 0 0 1 3.4-2M13.6 9.3A10 10 0 0 1 19 12M8.5 15.5a5 5 0 0 1 7 0" /><path d="M3 3l18 18" /><circle cx="12" cy="19" r=".6" fill="currentColor" /></>)}
  {name === "shield" && (<><path d="M12 3 4 6v6c0 4.5 3.4 8 8 9 4.6-1 8-4.5 8-9V6Z" /><path d="m8.5 12 2.5 2.5 4.5-5" /></>)}
  {name === "bolt" && <path d="M13 2 4 14h7l-1 8 9-12h-7Z" />}
  {name === "takeout" && (<><path d="M3 6h6l2 2h10v11H3Z" /><path d="M10 13h1.5M10 16h4M15 11.5l2 2-2 2" /></>)}
  {name === "duplicates" && (<><rect x="8" y="8" width="13" height="13" /><path d="M16 8V3H3v13h5" /><path d="m11.5 14.5 2 2 4-4" /></>)}
  {name === "calendar" && (<><rect x="3" y="5" width="18" height="16" /><path d="M3 10h18M8 3v4M16 3v4M7.5 14h2M11 14h2M14.5 14h2M7.5 17.5h2" /></>)}
  {name === "search" && (<><circle cx="11" cy="11" r="6.5" /><path d="m20 20-4.4-4.4" /></>)}
  {name === "album" && (<><rect x="3" y="3" width="18" height="18" /><path d="m3 16 5-5 4 4 3-3 6 6" /><circle cx="15.5" cy="8" r="1.5" /></>)}
  {name === "people" && (<><circle cx="9" cy="8" r="3.5" /><path d="M2.5 20a6.5 6.5 0 0 1 13 0" /><path d="M16 4.6a3.5 3.5 0 0 1 0 6.8M18 14.2a6.5 6.5 0 0 1 3.5 5.8" /></>)}
  {name === "zoom" && (<><circle cx="11" cy="11" r="6.5" /><path d="m20 20-4.4-4.4M11 8v6M8 11h6" /></>)}
  {name === "check" && <path d="m5 12.5 4.5 4.5L19 7.5" />}
  {name === "folder" && <path d="M3 6h6l2 2h10v11H3Z" />}
  {name === "file" && (<><path d="M6 3h8l4 4v14H6Z" /><path d="M14 3v4h4" /></>)}
  {name === "plus" && <path d="M12 5v14M5 12h14" />}
  {name === "megaphone" && (<><path d="M4 10v4h3l7 4V6L7 10Z" /><path d="M17.5 9.5a3.5 3.5 0 0 1 0 5" /></>)}
</svg>
