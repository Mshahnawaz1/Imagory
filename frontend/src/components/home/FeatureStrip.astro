---
// Four feature tabs. Each one shows a different app screenshot in the stage below.
import HomeIcon, { type HomeIconName } from "./HomeIcon.astro";
import Screenshot from "../Screenshot.astro";

type Item = {
  id: string;
  icon: HomeIconName;
  title: string;
  text: string;
  shot: { name: string; darkName?: string; width: number; height: number; alt: string };
  caption: string;
};

const items: Item[] = [
  {
    id: "offline",
    icon: "offline",
    title: "Fully offline",
    text: "No network connections, no account, no telemetry.",
    shot: {
      name: "welcome-light",
      width: 1600,
      height: 1000,
      alt: "Imagory's first-run screen: add a folder of photos or an extracted Google Takeout export.",
    },
    caption: "The first-run screen. Imagory only reads your photos, and nothing leaves your computer.",
  },
  {
    id: "readonly",
    icon: "shield",
    title: "Never touches your photos",
    text: "It only reads them. Nothing is changed, moved or deleted.",
    shot: {
      name: "cleanup-light",
      width: 640,
      height: 460,
      alt: "The Clean up Takeout preview, listing what will be copied and how much space it needs.",
    },
    caption: "Even Clean up Takeout only copies. It shows the plan first, and the export is left as it is.",
  },
  {
    id: "fast",
    icon: "bolt",
    title: "Fast",
    text: "Smooth scrolling through 100,000 photos.",
    shot: {
      name: "main-light",
      darkName: "main-dark",
      width: 1600,
      height: 1000,
      alt: "The photo grid with month headers, and the sidebar with people, albums and sources.",
    },
    caption: "One grid for every source, newest first, with month headers. Rescans only look at what changed.",
  },
  {
    id: "takeout",
    icon: "takeout",
    title: "Made for Google Takeout",
    text: "Dates, places and people from the JSON files.",
    shot: {
      name: "viewer-dark",
      width: 1600,
      height: 1000,
      alt: "The photo viewer with the info panel: date from the Takeout JSON, location and the person tagged.",
    },
    caption: "The viewer's info panel shows the date, place and people read from the Takeout export.",
  },
];
const first = items[0]!.id;
---
<section id="features" class="strip" aria-labelledby="features-title">
  <div class="container">
    <h2 id="features-title" class="sr-only">Features</h2>
    <div class="tabs" role="tablist" aria-label="Features" data-tabs>
      {items.map((it) => (
        <button
          type="button"
          role="tab"
          class="card tab"
          id={`tab-${it.id}`}
          aria-controls={`panel-${it.id}`}
          aria-selected={it.id === first ? "true" : "false"}
          tabindex={it.id === first ? 0 : -1}
        >
          <span class="icon-box"><HomeIcon name={it.icon} /></span>
          <span class="txt">
            <span class="t">{it.title}</span>
            <span class="d">{it.text}</span>
          </span>
        </button>
      ))}
    </div>

    <div class="stage">
      {items.map((it) => (
        <figure
          class:list={["panel", { small: it.shot.width < 1200 }]}
          role="tabpanel"
          id={`panel-${it.id}`}
          aria-labelledby={`tab-${it.id}`}
          hidden={it.id !== first}
          style={`--w: ${it.shot.width}px`}
        >
          <Screenshot
            name={it.shot.name}
            darkName={it.shot.darkName}
            width={it.shot.width}
            height={it.shot.height}
            alt={it.shot.alt}
            sizes="(min-width: 720px) 680px, 100vw"
            title={it.id === "readonly" ? "Clean up Takeout" : "Imagory"}
          />
          <figcaption>{it.caption}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-tabs]").forEach((list) => {
    const tabs = [...list.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const select = (tab: HTMLButtonElement, focus = false) => {
      for (const t of tabs) {
        const on = t === tab;
        t.setAttribute("aria-selected", String(on));
        t.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(t.getAttribute("aria-controls")!);
        if (panel) panel.hidden = !on;
      }
      if (focus) tab.focus();
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => select(tab));
      tab.addEventListener("keydown", (e) => {
        const step = { ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1 }[e.key];
        if (step) {
          e.preventDefault();
          select(tabs[(i + step + tabs.length) % tabs.length]!, true);
        } else if (e.key === "Home") { e.preventDefault(); select(tabs[0]!, true); }
        else if (e.key === "End") { e.preventDefault(); select(tabs[tabs.length - 1]!, true); }
      });
    });
  });
</script>

<style>
  .strip { padding-block: 0 clamp(32px, 4vw, 48px); }

  .tabs {
    display: grid; grid-template-columns: repeat(4, minmax(0, 256px));
    justify-content: center; gap: 12px;
  }
  .tab {
    display: flex; gap: 12px; align-items: flex-start; text-align: left;
    min-height: 0; padding: 14px 14px; font: inherit; color: var(--text); cursor: pointer;
    transition: border-color .15s, background-color .15s;
  }
  .tab:hover { border-color: var(--muted); }
  .tab .icon-box { width: 32px; height: 32px; }
  .tab .icon-box :global(svg) { width: 16px; height: 16px; }
  .txt { display: grid; gap: 2px; min-width: 0; }
  .t { font-weight: 600; font-size: .9rem; line-height: 1.3; }
  .d { color: var(--muted); font-size: .8125rem; line-height: 1.45; }
  .tab[aria-selected="true"] { border-color: var(--selection); box-shadow: inset 0 0 0 1px var(--selection); }
  .tab[aria-selected="true"] .icon-box {
    border-color: var(--selection); color: var(--forest);
    background: color-mix(in srgb, var(--accent) 35%, var(--surface));
  }
  :global(:root[data-theme-resolved="dark"]) .tab[aria-selected="true"] .icon-box {
    background: color-mix(in srgb, var(--accent) 16%, var(--surface)); color: var(--accent);
  }

  .stage { max-width: 640px; margin: 16px auto 0; }
  .panel { margin: 0; }
  .panel[hidden], .panel.small[hidden] { display: none; }
  .panel.small {
    display: grid; justify-items: center; padding: clamp(16px, 3vw, 32px) 16px;
    border: 1px solid var(--line); background-color: var(--paper);
    background-image: radial-gradient(var(--dot) 1px, transparent 1px); background-size: 18px 18px;
  }
  .panel.small > :global(*:first-child) { width: min(100%, var(--w), 460px); }
  figcaption { margin-top: 10px; text-align: center; color: var(--muted); font-size: .875rem; }
  .panel.small figcaption { margin-top: 16px; }

  @media (max-width: 1100px) { .tabs { grid-template-columns: repeat(2, minmax(0, 256px)); } }
  @media (max-width: 560px) {
    .tabs { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
    .tab { padding: 10px; gap: 8px; align-items: center; min-height: 56px; }
    .tab .icon-box { width: 28px; height: 28px; }
    .d { display: none; }
    .t { font-size: .8125rem; }
  }
</style>
