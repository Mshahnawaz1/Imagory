---
// Small inline icon set (stroke icons drawn for this site, 24x24 grid).
export type IconName =
  | "windows" | "linux" | "github" | "sun" | "moon" | "menu" | "close"
  | "arrow-right" | "download" | "external";
interface Props { name: IconName; class?: string; label?: string }
const { name, class: cls, label } = Astro.props;
const a11y = label ? { role: "img" as const, "aria-label": label } : { "aria-hidden": "true" as const };
---
<svg class={cls} viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor"
  stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" {...a11y}>
  {name === "windows" && (
    <g fill="currentColor" stroke="none">
      <rect x="3" y="3" width="8.25" height="8.25" /><rect x="12.75" y="3" width="8.25" height="8.25" />
      <rect x="3" y="12.75" width="8.25" height="8.25" /><rect x="12.75" y="12.75" width="8.25" height="8.25" />
    </g>
  )}
  {name === "linux" && (<><rect x="3" y="4" width="18" height="16" /><path d="m7 9 3 3-3 3M12.5 15H17" /></>)}
  {name === "github" && (
    <path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21" />
  )}
  {name === "sun" && (<><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></>)}
  {name === "moon" && <path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5Z" />}
  {name === "menu" && <path d="M4 7h16M4 12h16M4 17h16" />}
  {name === "close" && <path d="M6 6l12 12M18 6 6 18" />}
  {name === "arrow-right" && <path d="M5 12h14M13 6l6 6-6 6" />}
  {name === "download" && <path d="M12 4v11M7 10l5 5 5-5M5 20h14" />}
  {name === "external" && <path d="M14 4h6v6M20 4l-9 9M18 14v6H4V6h6" />}
</svg>
