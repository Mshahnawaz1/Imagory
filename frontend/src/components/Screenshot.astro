---
// An app screenshot from src/assets/screenshots/<name>.png, in a window frame.
// `darkName` is shown instead when the site is in dark mode. A missing file renders a
// CSS mock of the app with the same aspect ratio, so the page never breaks.
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

interface Props {
  name: string;
  darkName?: string;
  alt: string;
  width?: number;
  height?: number;
  class?: string;
  loading?: "lazy" | "eager";
  sizes?: string;
  /** Show the window title bar. Off for cropped panels. */
  chrome?: boolean;
  title?: string;
}

const {
  name,
  darkName,
  alt,
  width = 1600,
  height = 1000,
  class: cls,
  loading = "lazy",
  sizes = "(min-width: 1200px) 900px, 100vw",
  chrome = true,
  title = "Imagory",
} = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>("../assets/screenshots/*.png", {
  eager: true,
});
const find = (n?: string) => (n ? files[`../assets/screenshots/${n}.png`]?.default : undefined);
const light = find(name);
const dark = find(darkName);

const natural = light?.width ?? width;
const widths = [...new Set([480, 800, 1200, 1600].filter((w) => w < natural).concat(natural))];
const priority = loading === "eager" ? { fetchpriority: "high" as const } : {};

// Which mock to draw when the file is missing.
const kind = name.startsWith("viewer")
  ? "viewer"
  : name.startsWith("main")
    ? "grid"
    : name.startsWith("welcome")
      ? "welcome"
      : "dialog";
const mockDark = name.endsWith("-dark");
const tiles = Array.from({ length: 24 }, (_, i) => i);
const hues = ["#7fa38a", "#c9b37e", "#8ea7c2", "#b98c78", "#a4b56a", "#6f8f99", "#d0a46a", "#93876f"];
---
<figure class:list={["shot", { "no-chrome": !chrome }, cls]}>
  <div class="frame">
    {chrome && (
      <div class="titlebar" aria-hidden="true">
        <svg class="mark" viewBox="0 0 26 26" width="12" height="12">
          <rect width="26" height="26" fill="#10291F" />
          <rect x="8" y="6.5" width="6" height="5" fill="#BFE24B" />
          <rect x="8" y="14" width="6" height="8" fill="#F7F5EF" />
        </svg>
        <span>{title}</span>
        <span class="ctl"><i></i><i></i><i></i></span>
      </div>
    )}
    <div class="body" style={`aspect-ratio: ${width} / ${height}`}>
      {light ? (
        <>
          <Picture
            src={light}
            alt={alt}
            formats={["avif", "webp"]}
            widths={widths}
            sizes={sizes}
            loading={loading}
            decoding="async"
            class:list={["img", { "img-light": !!dark }]}
            {...priority}
          />
          {dark && (
            <Picture
              src={dark}
              alt={alt}
              formats={["avif", "webp"]}
              widths={widths}
              sizes={sizes}
              loading={loading}
              decoding="async"
              class="img img-dark"
            />
          )}
        </>
      ) : (
        <div class:list={["mock", `mock-${kind}`, { "mock-dark": mockDark }]} role="img" aria-label={alt}>
          {kind === "grid" && (
            <>
              <div class="m-side">
                <i class="w60 on"></i><i class="w40"></i><i class="w50"></i>
                <b></b><i class="w70"></i><i class="w50"></i><i class="w60"></i>
                <b></b><i class="w40"></i><i class="w60"></i>
              </div>
              <div class="m-main">
                <div class="m-bar"><i class="search"></i><i class="pill"></i><i class="pill"></i></div>
                <div class="m-head"></div>
                <div class="m-grid">
                  {tiles.slice(0, 12).map((i) => <span style={`background:${hues[i % hues.length]}`}></span>)}
                </div>
                <div class="m-head"></div>
                <div class="m-grid">
                  {tiles.slice(12).map((i) => <span style={`background:${hues[(i * 3) % hues.length]}`}></span>)}
                </div>
              </div>
            </>
          )}
          {kind === "viewer" && (
            <>
              <div class="m-photo"><span></span></div>
              <div class="m-info">
                <i class="w60"></i><i class="w80"></i><b></b><i class="w50"></i><i class="w70"></i><b></b><i class="w60"></i>
              </div>
            </>
          )}
          {kind === "dialog" && (
            <div class="m-dialog">
              <i class="w40 title"></i>
              {[0, 1, 2].map(() => <div class="row"><span></span><i class="w60"></i><i class="w20"></i></div>)}
              <div class="btns"><i></i><i class="primary"></i></div>
            </div>
          )}
          {kind === "welcome" && (
            <div class="m-welcome"><span class="logo"></span><i class="w60"></i><i class="btn"></i></div>
          )}
          <span class="m-label">{name}.png</span>
        </div>
      )}
    </div>
  </div>
</figure>

<style>
  .shot { margin: 0; }
  .frame { position: relative; }
  .titlebar {
    display: flex; align-items: center; gap: 8px; height: 28px; padding: 0 12px;
    background: var(--surface-alt); border-bottom: 1px solid var(--line);
    font: 500 12px/1 var(--font-sans); color: var(--muted);
  }
  .titlebar .mark { flex: none; }
  .ctl { margin-left: auto; display: flex; gap: 10px; }
  .ctl i { width: 9px; height: 9px; border: 1.5px solid var(--muted); opacity: .6; }
  .body { position: relative; overflow: hidden; background: var(--viewer); }
  .body :global(picture), .body :global(.img) { display: block; width: 100%; height: 100%; }
  .body :global(.img) { object-fit: cover; object-position: left top; }
  .body :global(picture:has(.img-dark)) { display: none; }
  :global(:root[data-theme-resolved="dark"]) .body :global(picture:has(.img-light)) { display: none; }
  :global(:root[data-theme-resolved="dark"]) .body :global(picture:has(.img-dark)) { display: block; }

  /* Placeholder mock, drawn in the site's tokens */
  .mock {
    --m-bg: var(--bg); --m-surface: var(--surface); --m-line: var(--line); --m-ink: var(--muted);
    position: absolute; inset: 0; display: flex; background: var(--m-bg); color: var(--m-ink);
  }
  .mock-dark, .mock-viewer {
    --m-bg: #0b1a15; --m-surface: #10241d; --m-line: #24413a; --m-ink: #8fa397;
  }
  .mock i { display: block; height: 6px; background: var(--m-line); }
  .mock b { display: block; height: 10px; }
  .w20 { width: 20%; } .w40 { width: 40%; } .w50 { width: 50%; } .w60 { width: 60%; } .w70 { width: 70%; } .w80 { width: 80%; }
  .m-side { flex: 0 0 18%; display: flex; flex-direction: column; gap: 9px; padding: 4% 2.5%; background: var(--m-surface); border-right: 1px solid var(--m-line); }
  .m-side .on { background: #bfe24b; height: 8px; }
  .m-main { flex: 1; padding: 2.5% 3%; display: flex; flex-direction: column; gap: 2.2%; min-width: 0; }
  .m-bar { display: flex; gap: 8px; align-items: center; }
  .m-bar .search { width: 30%; height: 14px; border: 1px solid var(--m-line); background: var(--m-surface); }
  .m-bar .pill { width: 9%; height: 14px; }
  .m-head { width: 18%; height: 9px; background: var(--m-ink); opacity: .55; margin-top: 1%; }
  .m-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 1.2%; }
  .m-grid span { aspect-ratio: 1; opacity: .75; }
  .m-photo { flex: 1; display: grid; place-items: center; }
  .m-photo span { width: 62%; aspect-ratio: 3 / 2; background: linear-gradient(160deg, #8ea7c2 0%, #7fa38a 55%, #c9b37e 100%); opacity: .8; }
  .m-info { flex: 0 0 24%; display: flex; flex-direction: column; gap: 10px; padding: 4% 2.5%; background: var(--m-surface); border-left: 1px solid var(--m-line); }
  .mock-dialog, .mock-welcome { align-items: center; justify-content: center; }
  .m-dialog { width: 62%; padding: 3%; display: flex; flex-direction: column; gap: 14px; background: var(--m-surface); border: 1px solid var(--m-line); }
  .m-dialog .title { height: 10px; background: var(--m-ink); opacity: .6; }
  .m-dialog .row { display: flex; gap: 12px; align-items: center; padding: 8px 0; border-bottom: 1px solid var(--m-line); }
  .m-dialog .row span { width: 22px; height: 22px; background: var(--m-line); flex: none; }
  .m-dialog .row .w20 { margin-left: auto; }
  .m-dialog .btns { display: flex; justify-content: flex-end; gap: 8px; }
  .m-dialog .btns i { width: 14%; height: 18px; border: 1px solid var(--m-line); background: none; }
  .m-dialog .btns .primary { background: #10291f; border-color: #10291f; }
  .mock-dark .m-dialog .btns .primary { background: #bfe24b; border-color: #bfe24b; }
  .m-welcome { width: 40%; display: flex; flex-direction: column; align-items: center; gap: 14px; }
  .m-welcome .logo { width: 44px; height: 44px; background: #10291f; box-shadow: inset 0 0 0 14px #10291f, inset 0 0 0 30px #bfe24b; }
  .m-welcome .btn { width: 36%; height: 20px; background: #10291f; }
  .m-label {
    position: absolute; right: 10px; bottom: 8px; padding: 2px 8px;
    font: 400 11px/1.6 var(--font-mono); color: var(--m-ink);
    background: var(--m-surface); border: 1px solid var(--m-line);
  }
</style>
